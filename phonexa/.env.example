# phonexa's own .env — phonexa-local values only.
#
# Anything used by more than one project (POSTGRES_PASSWORD, SMIA_AUTH_TOKEN,
# OPERATOR_AUTH_TOKEN, …) lives in the repository-root .env and must NOT be
# repeated here: no value is defined in two files. Derived values
# (DATABASE_URL, SMIA_BASE_URL) are computed in compose.yaml and typed nowhere.

# Where audio blobs are stored. Only 'local' is implemented (db/storage.py);
# the backend already defaults to 'local', so leave this unset unless and
# until another backend exists.
AUDIO_BACKEND=local
