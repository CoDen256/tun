# tun's own .env — only what the services defined directly in
# tun/compose.yaml need (adminer needs nothing; backup needs the below).
# mjolnir's and stabbur's own secrets live in their own .env/compose files —
# never duplicated here except where explicitly noted.

# compose-backup-service (git-backup's delivery mechanism) ------------------

# SSH URL of the private git repository backups are pushed to.
BACKUP_REPO_URL=git@github.com:your-username/tun-backup.git

# Host path to the ONE private SSH key used to push to that repo — not your
# whole ~/.ssh directory (D-C3). This key needs write access to
# BACKUP_REPO_URL above; add its public half as a deploy key on that repo,
# or as a regular key on your GitHub account if you're reusing one you
# already use for other repos.
BACKUP_SSH_KEY_PATH=/home/you/.ssh/id_ed25519

# stabbur's compose.yaml hardcodes POSTGRES_PASSWORD: stabbur directly
# (not env-file-driven) — set this to match it exactly. If you ever change
# stabbur's own compose.yaml to use a different password, update this too;
# nothing keeps the two in sync automatically.
STABBUR_POSTGRES_PASSWORD=stabbur

# How often the backup runs, in seconds. Default: once a day.
BACKUP_INTERVAL_SECONDS=86400

# mjolnir's own POSTGRES_PASSWORD is read directly from ../mjolnir/.env
# (env_file in compose.yaml) — not duplicated here.
