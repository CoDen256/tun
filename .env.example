# The root .env — values used by MORE THAN ONE project (D151).
#
# A value used by exactly one project belongs in that project's own .env:
#   smia/.env             HF_TOKEN, DEEPL_TOKEN, ELEVENLABS_TOKEN
#   mjolnir/.env          ALLOW_HTTP, ALLOW_NO_COMPANION, SOURCE_LANG
#   phonexa/.env          AUDIO_BACKEND
#
# Nothing is duplicated between those files and this one. Anything derivable
# (every DATABASE_URL, every upstream address) is computed in compose and
# appears in no .env at all.

# --- site ------------------------------------------------------------------
TUN_SITE_ADDRESS=tun.example.net        # bare hostname => automatic HTTPS; ":8080" for local plain HTTP
TUN_PUBLIC_BASE=https://tun.example.net

# --- auth ------------------------------------------------------------------
# DEVICE PLANE. Baked into the APK; the phone sends it on every /ota/* request.
# Rotatable only through the on-device config.json mechanism (D39) — changing
# it here alone cuts every installed device off from updates.
OTA_TOKEN=<openssl rand -hex 32>

# OPERATOR PLANE. One credential for every operator-facing zone.
# *** LEAVING THIS UNSET DOES NOT LOCK THE CONSOLE — IT OPENS IT. ***
# mjolnir's hub and builder wrap their whole auth check in
# `if (config.operatorAuthToken)` (D-H6, deliberate local-dev ergonomics), so
# with no value set /mjolnir and /builder serve every page to anyone who
# reaches the host. The /phonexa gate is the opposite and fails closed. Set a
# real value on any deploy reachable from the internet. `unified-auth` removes
# this asymmetry by moving the check into the gateway, where unset fails closed.
# WARNING, true until unified-auth lands: the device's progress-sync shim
# validates against THIS value too (patches/js/2080-progress-sync-shim),
# so rotating it also breaks device sync until a new config.json is pushed.
OPERATOR_AUTH_TOKEN=<a long random token>

# INTERNAL. Service-to-service calls, which never pass through the gateway.
# Still two separate values today; unified-auth collapses them into one
# INTERNAL_TOKEN.
STABBUR_AUTH_TOKEN=<a long random token>
SMIA_AUTH_TOKEN=<a long random token>

# --- databases -------------------------------------------------------------
# One password per database, and NOT one shared value. Postgres applies a
# password only when it initialises a fresh data directory, so the three
# existing volumes still carry the literals they were created with. A single
# shared value would authenticate against none of them, with an auth failure
# as the only symptom. postgres-consolidation collapses these into one
# POSTGRES_PASSWORD when it dump/restores into a fresh cluster.
MJOLNIR_POSTGRES_PASSWORD=<the value currently in mjolnir/.env as POSTGRES_PASSWORD>
STABBUR_POSTGRES_PASSWORD=stabbur
SMIA_POSTGRES_PASSWORD=smia
PHONEXA_POSTGRES_PASSWORD=phonexa

# --- backup ----------------------------------------------------------------
# SSH URL of the private git repository backups are pushed to.
BACKUP_REPO_URL=git@github.com:your-username/tun-backup.git
# Host path to the ONE private key used to push there (D-C3) — not your whole
# ~/.ssh. Add its public half as a deploy key on that repo.
BACKUP_SSH_KEY_PATH=/home/you/.ssh/id_ed25519
# How often the backup runs, in seconds. Default: once a day.
BACKUP_INTERVAL_SECONDS=86400
