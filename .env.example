# Copy to .env on the VPS and fill in. .env is gitignored — never commit it.

# Production: the bare hostname, which turns on automatic HTTPS.
#   TUN_SITE_ADDRESS=tun.example.net
# Local testing: a plain-HTTP port.
#   TUN_SITE_ADDRESS=:8080
TUN_SITE_ADDRESS=tun.example.net


# The OTA bearer token. Generate with:  openssl rand -hex 32
# This is the token baked into the APK (D39) — it is the BOOTSTRAP token.
# Because a JS bundle can rewrite config.json, it is rotatable later by
# publishing (see docs/08-pitfalls.md P23).
OTA_TOKEN=changeme

# Only needed from P4 onward (docker compose --profile db).
POSTGRES_PASSWORD=changeme

# Used by bin/ota-publish.sh to build the absolute url in current.json.
# MUST be https (D53).
TUN_PUBLIC_BASE=https://tun.example.net
