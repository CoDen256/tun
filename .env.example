# The root .env — values used by MORE THAN ONE project (D151).
#
# A value used by exactly one project belongs in that project's own .env:
#   smia/.env             HF_TOKEN, DEEPL_TOKEN, ELEVENLABS_TOKEN
#   mjolnir/.env          ALLOW_HTTP, ALLOW_NO_COMPANION, SOURCE_LANG
#   phonexa/.env          AUDIO_BACKEND
#
# Nothing is duplicated between those files and this one. Anything derivable
# (every DATABASE_URL, every upstream address) is computed in compose and
# appears in no .env at all.

# --- site ------------------------------------------------------------------
TUN_SITE_ADDRESS=tun.example.net        # bare hostname => automatic HTTPS; ":8080" for local plain HTTP
TUN_PUBLIC_BASE=https://tun.example.net

# --- auth ------------------------------------------------------------------
# DEVICE PLANE. Baked into the APK; the phone sends it on every /ota/* request.
# Rotatable only through the on-device config.json mechanism (D39) — changing
# it here alone cuts every installed device off from updates.
OTA_TOKEN=<openssl rand -hex 32>

# OPERATOR PLANE. One credential for every operator-facing zone: the gateway
# hashes it at boot and `basic_auth` checks it on all seven zones (username
# `operator`). unified-auth 3.1/3.2 removed every way this could be left
# unset-and-open — there is no hash to type and no service that disables its
# own gate any more, and compose refuses to start the gateway without it.
#
# Rotatable on its own since unified-auth 7.1: the device's sync credential
# is SYNC_TOKEN (below), which defaults to this value but no longer follows
# it — see DEPLOY.md §4 before rotating.
OPERATOR_AUTH_TOKEN=<a long random token>

# The DEVICE's progress-sync credential (unified-auth 7.1). Unset, it falls
# back to OPERATOR_AUTH_TOKEN — correct for a fresh install where both are
# the value the published bundle carries. BEFORE rotating the operator
# password, pin this to the value the field device actually sends, or the
# fallback moves with the rotation and 302s every sync: the device's copy is
# baked into its JS bundle (P48) and changes only via assemble-and-publish.
# The full sequence is DEPLOY.md §4.
#SYNC_TOKEN=

# INTERNAL. Service-to-service calls, which never pass through the gateway:
# builder -> stabbur, stabbur -> smia, shadow -> smia, shadow -> phonexa.
# ONE value since unified-auth 4.6, replacing STABBUR_AUTH_TOKEN and
# SMIA_AUTH_TOKEN (both retired names — bin/check-standards.sh fails if
# either is ever typed into a .env.example again).
#
# It is NOT the browser's credential. A human never sends this: the gateway
# authenticates the operator with Basic and vouches for the request with an
# X-Tun-Operator header the services trust instead.
INTERNAL_TOKEN=<a long random token>

# --- databases -------------------------------------------------------------
# ONE value. postgres-consolidation restored five databases into one fresh
# cluster, which is the only moment Postgres can apply a new password at all
# (it reads POSTGRES_PASSWORD only when it initialises a data directory), and
# postgres/init/bootstrap.sh derives every service role's password from this
# one as "<POSTGRES_PASSWORD>_<db>".
POSTGRES_PASSWORD=<a long random password>

# MJOLNIR_POSTGRES_PASSWORD, STABBUR_POSTGRES_PASSWORD, SMIA_POSTGRES_PASSWORD
# and PHONEXA_POSTGRES_PASSWORD were HERE, and were still sitting in the live
# root .env on 2026-11-14 — four lines reading as four live credentials in the
# one file D151 made authoritative, in a stack where no compose file has
# interpolated any of them since the consolidation. Removed, and listed in
# bin/check-standards.sh's retired set so none of them can be retyped.
#
# They are not gone from the world: the four RETAINED pre-cutover volumes
# still have their own old passwords baked in, and DEPLOY.md §3b has the
# table. If you ever mount one of those to read it, export the value for that
# one command — it is not configuration of this stack and does not belong in
# this file.

# --- backup ----------------------------------------------------------------
# SSH URL of the private git repository backups are pushed to.
BACKUP_REPO_URL=git@github.com:your-username/tun-backup.git
# Host path to the ONE private key used to push there (D-C3) — not your whole
# ~/.ssh. Add its public half as a deploy key on that repo.
BACKUP_SSH_KEY_PATH=/home/you/.ssh/id_ed25519
# How often the backup runs, in seconds. Default: once a day.
BACKUP_INTERVAL_SECONDS=86400
